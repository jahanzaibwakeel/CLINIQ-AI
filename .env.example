# App
# Example local values. Change these for your machine, tunnel, or production domain.
APP_HOST_PORT=3000
APP_CONTAINER_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated allowed browser origins. Useful when testing through 127.0.0.1 or a tunnel.
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Database
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://medipilot:medipilot@localhost:5432/medipilot_ai?schema=public

# Valkey/Redis
VALKEY_HOST_PORT=6379
VALKEY_URL=redis://localhost:6379

# Document storage
DOCUMENT_STORAGE_DIR=uploads
DOCUMENT_MAX_UPLOAD_BYTES=2000000

# Optional operations monitoring. Leave blank to require admin session access.
METRICS_BEARER_TOKEN=

# Optional SMTP email delivery for password resets and staff invites.
# Leave blank in development to log safe preview links to server logs.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediPilot AI <no-reply@medipilot.local>"
ACCOUNT_TOKEN_RETENTION_DAYS=7

# AI: local-first by default
AI_PROVIDER=ollama
OLLAMA_HOST=localhost
OLLAMA_HOST_PORT=11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_PREDICT=220
OLLAMA_REQUEST_TIMEOUT_MS=1500

# Optional external providers. Do not set unless clinic policy permits sending PHI externally.
ALLOW_EXTERNAL_AI=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
