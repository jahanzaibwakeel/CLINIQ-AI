{
  "name": "clinik-ai",
  "version": "0.1.0",
  "private": true,
  "description": "CLINIK AI - local-first AI clinical workflow assistant for doctors and small clinics.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "release:check": "node scripts/production-check.mjs",
    "ops:monitor": "node scripts/ops-monitor.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "security:cleanup-tokens": "tsx scripts/account-token-cleanup.ts",
    "security:audit": "npm audit --audit-level=high --omit=optional"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.18",
    "jsdom": "^25.0.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.15"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
