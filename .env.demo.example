# Recruiter demo hosting example for Vercel + Neon + Upstash.
# Do not commit a real .env file. Copy these values into Vercel project environment variables.

NEXT_PUBLIC_APP_URL=https://your-vercel-project.vercel.app
TRUSTED_ORIGINS=https://your-vercel-project.vercel.app

# Neon pooled PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# Generate with: npm run secrets:generate
SESSION_SECRET=replace-with-generated-session-secret

# Demo mode: no paid/external AI. The local safe fallback keeps AI flows usable.
AI_PROVIDER=fallback
ALLOW_EXTERNAL_AI=false

# Upstash Redis TLS URL. Leave blank to use in-memory fallback for a light demo.
VALKEY_URL=rediss://default:password@host.upstash.io:6379
METRICS_BEARER_TOKEN=replace-with-generated-monitor-token

# Vercel serverless can write temporary files only. Extracted text and metadata remain in Postgres.
DOCUMENT_STORAGE_DIR=/tmp/uploads
DOCUMENT_MAX_UPLOAD_BYTES=1000000

# Optional email. Leave blank for demo-safe logged preview links.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediPilot AI <no-reply@example.com>"
ACCOUNT_TOKEN_RETENTION_DAYS=7
