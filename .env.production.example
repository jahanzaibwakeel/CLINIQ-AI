# Production example for docker-compose.prod.yml
# Replace these per server. Keep APP_BIND_ADDRESS as 127.0.0.1 when Caddy/Nginx terminates HTTPS on the same host.
APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=3000
APP_CONTAINER_PORT=3000
NEXT_PUBLIC_APP_URL=https://medipilot.example.com
# Add additional approved origins only when required by your proxy, staging URL, or domain migration.
TRUSTED_ORIGINS=https://medipilot.example.com
# Optional for npm run release:check endpoint validation.
PRODUCTION_CHECK_URL=https://medipilot.example.com

# Optional docker-compose.prod.yml HTTPS proxy profile.
DOMAIN=medipilot.example.com
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

POSTGRES_USER=medipilot
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=medipilot_ai

SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
METRICS_BEARER_TOKEN=replace-with-monitoring-token-or-leave-blank
MONITOR_BASE_URL=https://medipilot.example.com
MONITOR_TIMEOUT_MS=10000
MONITOR_REQUIRE_METRICS=true

DOCUMENT_STORAGE_DIR=/app/uploads
DOCUMENT_MAX_UPLOAD_BYTES=2000000

AI_PROVIDER=ollama
ALLOW_EXTERNAL_AI=false

# Use when Ollama is enabled in the same production Compose stack.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_PREDICT=220
OLLAMA_REQUEST_TIMEOUT_MS=1500

# Optional external providers. Only configure after clinic approval.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional SMTP email delivery for account recovery and staff invites.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediPilot AI <no-reply@medipilot.example.com>"
ACCOUNT_TOKEN_RETENTION_DAYS=7
