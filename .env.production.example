# Production example for docker-compose.prod.yml
APP_HOST_PORT=3000
APP_CONTAINER_PORT=3000
NEXT_PUBLIC_APP_URL=https://medipilot.example.com

POSTGRES_USER=medipilot
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=medipilot_ai

SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
AI_PROVIDER=ollama
ALLOW_EXTERNAL_AI=false

# Use when Ollama is enabled in the same production Compose stack.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_PREDICT=220

# Optional external providers. Only configure after clinic approval.
GROQ_API_KEY=
GEMINI_API_KEY=
